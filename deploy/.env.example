JAHAN_ENVIRONMENT=production
JAHAN_LOG_LEVEL=INFO
JAHAN_DOCS_ENABLED=false
JAHAN_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DATABASE_HOST:5432/jahan_academy
JAHAN_REDIS_URL=redis://:PASSWORD@REDIS_HOST:6379/0
JAHAN_SESSION_SECRET=replace-with-a-cryptographically-random-secret
JAHAN_COOKIE_SECURE=true
JAHAN_FRONTEND_URL=https://example.com
JAHAN_SMTP_HOST=smtp.example.com
JAHAN_SMTP_PORT=587
JAHAN_SMTP_USERNAME=replace-me
JAHAN_SMTP_PASSWORD=replace-me
JAHAN_SMTP_START_TLS=true
JAHAN_EMAIL_FROM=no-reply@example.com

JAHAN_ENVIRONMENT=local
JAHAN_LOG_LEVEL=INFO
JAHAN_DOCS_ENABLED=true
JAHAN_DATABASE_URL=postgresql+asyncpg://jahan:jahan_local@localhost:55432/jahan_academy
JAHAN_REDIS_URL=redis://localhost:6379/0
JAHAN_SESSION_COOKIE_NAME=jahan_session
JAHAN_REFRESH_COOKIE_NAME=jahan_refresh
JAHAN_CSRF_COOKIE_NAME=jahan_csrf
JAHAN_SESSION_SECRET=replace-with-at-least-32-random-characters
JAHAN_JWT_ISSUER=jahan-academy
JAHAN_JWT_AUDIENCE=jahan-academy-api
JAHAN_ACCESS_TOKEN_MINUTES=15
JAHAN_REFRESH_TOKEN_DAYS=30
JAHAN_EMAIL_VERIFICATION_HOURS=24
JAHAN_PASSWORD_RESET_MINUTES=30
JAHAN_LOGIN_MAX_ATTEMPTS=5
JAHAN_LOGIN_LOCK_MINUTES=15
JAHAN_COOKIE_SECURE=false
JAHAN_FRONTEND_URL=http://localhost:3000
JAHAN_SMTP_HOST=localhost
JAHAN_SMTP_PORT=1025
JAHAN_SMTP_START_TLS=false
JAHAN_EMAIL_FROM=no-reply@jahanacademy.local
JAHAN_NOURA_BASE_URL=http://localhost:8090
JAHAN_NOURA_TIMEOUT_SECONDS=5
JAHAN_NOURA_MOCK_OUTCOME=success
JAHAN_NOURA_DISPATCH_BATCH_SIZE=20
JAHAN_NOURA_LOCK_TIMEOUT_SECONDS=600
